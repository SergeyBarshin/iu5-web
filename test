/* request.css */

/* Заголовок страницы */
.frame > .text-wrapper {
  font-size: 32px;
  font-weight: 700;
  margin-bottom: 30px;
}

/* Блок с итоговой прибылью */
.view {
  background-color: var(--color-white);
  padding: 24px;
  border-radius: var(--border-radius-lg);
  box-shadow: var(--shadow-sm);
  margin-bottom: 30px;
}
.view-2 {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}
.div-wrapper .text-wrapper-2,
.view-3 .text-wrapper-2 {
  font-size: 18px;
  font-weight: 500;
  border: none;
  background: transparent;
  outline: none;
  width: 100%;
}

.view-wrapper {
  flex-grow: 1;
  max-width: 300px;
}
.view-3 {
  padding: 12px 16px;
  border: 1px solid #ddd;
  border-radius: var(--border-radius-md);
}

/* Стилизация списка акционеров */
.view-5 {
  background-color: var(--color-white);
  padding: 24px;
  border-radius: var(--border-radius-lg);
  box-shadow: var(--shadow-sm);
}

/* Заголовки таблицы */
.frame-wrapper {
  padding: 0 16px;
  margin-bottom: 16px;
  display: none; /* Скроем заголовки, т.к. в дизайне их нет, но оставим для возможного использования */
}

/* Строка одного акционера */
.element {
  display: flex;
  align-items: center;
  gap: 24px;
  padding: 16px 0;
  border-bottom: 1px solid #f0f0f0;
}
.element:last-child {
  border-bottom: none;
}
/* Левая часть с информацией об акционере */
.view-7 {
  flex: 1.5; /* Занимает больше места */
  display: flex;
  align-items: center;
  gap: 20px;
}
.image {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  object-fit: cover;
}
.text-wrapper-5 {
  font-size: 18px;
  font-weight: 700;
}
.view-8 p {
  font-size: 14px;
  color: var(--color-text-secondary);
}
.background-border {
  display: none; /* Скрываем полное описание в этом виде */
}

/* Правая часть с полями ввода */
.view-10 {
  flex: 2; /* Занимает еще больше места */
}
.view-10 .div-2 {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  align-items: center;
}
.view-11 {
  text-align: center;
}
/* Поля ввода */
.view-13 input {
  width: 100%;
  padding: 10px;
  border: 1px solid #ddd;
  border-radius: var(--border-radius-md);
  text-align: center;
  font-size: 16px;
  font-family: "Inter", sans-serif;
}
/* Стиль для поля "Итоговая прибыль", которое только для чтения */
.view-13 input[readonly] {
  background-color: var(--color-background);
  font-weight: bold;
  color: var(--color-text-primary);
  border: 1px solid transparent;
}

/* Кнопка "Пересчитать" */
form > button.view-6 {
  margin: 40px auto;
  display: block;
  width: 100%;
  max-width: 250px;
}

/* Итоговая строка */
.frame-5 {
  text-align: right;
  margin-top: 24px;
}
.text-wrapper-7 {
  font-size: 18px;
  font-weight: 500;
  color: var(--color-text-secondary);
}